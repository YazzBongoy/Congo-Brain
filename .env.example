# Congo-Brain — Variables d'environnement

# ── Base de données ───────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://congo:replace-with-a-long-random-password@postgres:5432/congo_brain

# ── Sécurité ─────────────────────────────────────────────────
SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=60

# ── Keycloak ──────────────────────────────────────────────────
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=congo-brain
KEYCLOAK_CLIENT_ID=congo-brain-api
KEYCLOAK_CLIENT_SECRET=replace-with-generated-client-secret
# Leave empty for a fresh realm. Set REMOVE only after approving deletion of
# the legacy realm-local admin/admin123 demonstration account.
CONFIRM_REMOVE_LEGACY_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# ── IA ────────────────────────────────────────────────────────
ANOMALY_THRESHOLD=0.7
RISK_SCORE_THRESHOLD=75.0

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Environnement ─────────────────────────────────────────────
ENVIRONMENT=development
