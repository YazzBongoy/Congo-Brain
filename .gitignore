# Git ignore for IAGov project
# Python / virtualenv
__pycache__/
*.py[cod]
*.so
venv/
.venv/
.env

# Test / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artefacts
build/
dist/
*.egg-info/

# Docker artefacts
docker-compose.override.yml
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Test coverage
coverage.xml
htmlcov/
.coverage

# Secrets
*.pem
*.key

# Databases
*.db
# Root-level local/test SQLite artifacts (never commit these)
/congo_brain.db
/test_congo_brain.db

# Virtual environments
node_modules/
frontend/dist/

# Alembic
alembic/versions/*.pyc
